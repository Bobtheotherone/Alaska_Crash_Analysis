__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Local, de-identified modelling table built from the licensed raw extract (never committed).
_local_data/

# Run bundles carry per-crash predictions keyed by Crash Number (an identifier); keep local.
runs/

# Split assignment maps Crash Number -> partition; keep local (privacy).
# (** patterns cover nested sensitivity out-dirs, e.g. experiment/broad_sensitivity/ — an
# unmatched nested FROZEN.lock previously made the finalize-time porcelain look dirty.)
experiment/**/split_assignment.csv
experiment/split_assignment.csv
experiment/**/FINAL.done
experiment/FINAL.done
# Local governance lock (regenerated by `freeze-experiment`; pins hashes + git commit).
experiment/**/FROZEN.lock
experiment/FROZEN.lock

# Per-crash revision-addendum evidence (surrogate-keyed; hashes pinned in the committed
# experiment/*.json artifacts; shipped via the release package, not via git)
experiment/predictions_lossless.parquet
experiment/missingness_only_predictions.parquet

# Packaging outputs (git bundle + release archive; not committed)
dist/

# LaTeX build outputs (the built PDF ships via the release package, not git;
# figures/user/*.pdf are committed inputs and are NOT covered by these patterns)
paper/latex/main.pdf
paper/latex/*.aux
paper/latex/*.bbl
paper/latex/*.blg
paper/latex/*.lof
paper/latex/*.lot
paper/latex/*.out
paper/latex/*.toc
paper/latex/build*.out
paper/latex/bib.out
paper/latex/page_render/
